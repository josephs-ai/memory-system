classDef source fill:#15243d,stroke:#6ea8fe,color:#edf2ff,stroke-width:2px;
classDef policy fill:#1f2940,stroke:#8cb4ff,color:#edf2ff,stroke-width:2px;
classDef pipeline fill:#1c2a35,stroke:#4dd4ac,color:#edf2ff,stroke-width:2px;
classDef queue fill:#2f2a1c,stroke:#ffd166,color:#edf2ff,stroke-width:2px;
classDef database fill:#271d35,stroke:#c084fc,color:#edf2ff,stroke-width:2px;
classDef tensor fill:#183535,stroke:#2dd4bf,color:#edf2ff,stroke-width:2px;
classDef project fill:#2b2233,stroke:#fb7185,color:#edf2ff,stroke-width:2px;
classDef inventory fill:#2b2233,stroke:#fb7185,color:#edf2ff,stroke-width:2px;
classDef component fill:#162642,stroke:#6ea8fe,color:#edf2ff,stroke-width:2px;
subgraph retrieval_canonical["Retrieval System (Canonical)"]
direction LR
    search_core["Search Runtime Core<br/>search_runtime.py"]
    search_interfaces["Search Interfaces<br/>CLI, Service, RBAC Wrappers"]
    search_interfaces -->|calls core| search_core
end
subgraph watchdog["Watchdog System"]
direction LR
    path_watcher["Tracked Path Watcher<br/>tracked_path_watcher.py"]
end
subgraph save_memory["Save Memory System"]
direction LR
    write_runtime["Checkpoint Write Runtime<br/>checkpoint_write_runtime.py"]
    write_interfaces["Write Interfaces<br/>CLI Wrappers"]
    project_scaffold["Project Scaffold<br/>create_project_scaffold.py"]
    trigger_cycles["Trigger Cycles<br/>run_pipeline_runtime.py"]
    write_interfaces -->|calls core| write_runtime
end
subgraph control["Control + Heartbeat Tree"]
direction LR
    ui["Control Panel / Dashboard<br/>web UI, commands, agents, projects, architecture explorer"]
    heartbeat_global["Global Heartbeat Policy<br/>HEARTBEAT.md + global cadence / mode rules"]
    heartbeat_agents["Agent Heartbeat / Role Rules<br/>HEARTBEAT_AGENTS.md + policy enforcement"]
    ui -->|configure| heartbeat_global
    heartbeat_global -->|specialize| heartbeat_agents
end
subgraph ingest["Ingest + Dehydrate Tree"]
direction LR
    transcript_sources["Transcript / Session Sources<br/>raw session text, agent output, workspace state"]
    dehydrate["Dehydrate Transcript<br/>strip noise, normalize transcript structure"]
    chunking["Chunk + Update Extraction<br/>topic chunking and change extraction"]
    filter_judge["Filter + Judge Candidates<br/>field extraction, scope, confidence, route hint"]
    transcript_sources -->|clean| dehydrate
    dehydrate -->|chunk| chunking
    chunking -->|judge| filter_judge
end
subgraph routing["Routing + Review Tree"]
direction LR
    route_single["Single / Batch Routing<br/>route to inbox, discarded, pending stable, auto"]
    queue_inbox["memory_inbox<br/>review queue"]
    queue_pending["memory_pending_stable<br/>approval gate for strong stable memory"]
    queue_discarded["memory_discarded<br/>discard history and reject cache"]
    approval_ops["Approval / Lifecycle Ops<br/>approve, reject, promote, demote, restore, auto-process"]
    route_single -->|review| queue_inbox
    route_single -->|stable gate| queue_pending
    route_single -->|reject| queue_discarded
    queue_pending -->|approve/reject| approval_ops
    queue_inbox -->|promote/demote| approval_ops
end
subgraph canonical["Canonical Registry Tree"]
direction LR
    registry_write["Canonical Write Path<br/>select best, reconcile, patch, and write canonical memory"]
    registry_db_api["memory_db.py<br/>DB API for items, queues, feedback, embeddings, search"]
    memory_items_table["memory_items<br/>canonical active / superseded / archived / uncertain rows"]
    markdown_sync["Markdown Sync + Human Files<br/>sync registry back to readable memory markdown"]
    registry_write -->|upsert| registry_db_api
    registry_db_api -->|store| memory_items_table
    memory_items_table -->|sync| markdown_sync
end
subgraph retrieval["Retrieval + Tensor Tree"]
direction LR
    embedding_path["Tensor / Embedding Path<br/>Sentence-Transformers all-MiniLM-L6-v2 encoding"]
    embeddings_table["memory_item_embeddings<br/>vector table for pgvector-backed similarity search"]
    hybrid_search["Hybrid Search Layer<br/>FTS + vector score + structured bonuses + RBAC"]
    retrieval_feedback_table["retrieval_feedback<br/>useful/bad operator judgments for ranking adaptation"]
    feedback_loop["Retrieval Feedback Loop<br/>mark useful/bad, adjust ranking, inspect low utility"]
    embedding_path -->|embed| embeddings_table
    embeddings_table -->|vector rank| hybrid_search
    hybrid_search -->|log outcome| retrieval_feedback_table
    retrieval_feedback_table -->|feedback| feedback_loop
    feedback_loop -->|tune rank| hybrid_search
end
subgraph ops["Inspection + Migration Tree"]
direction LR
    maintenance["Maintenance / Report Surface<br/>queue, maintenance, conflicts, recent writes, promotion views"]
    migrations["Migration / Backfill Utilities<br/>legacy JSONL to DB and feedback migration"]
    projects["Project File Memory<br/>current.md, milestones, daily notes, tracked project files"]
    inventory["Full Script Inventory<br/>all scripts in .memory-index/scripts grouped automatically"]
    maintenance -->|backfill| migrations
    maintenance -->|inspect| projects
    maintenance -->|catalog| inventory
end
ui -. monitor .-> transcript_sources
heartbeat_agents -. policy ceiling .-> filter_judge
filter_judge -. judge output .-> route_single
approval_ops -. approved write .-> registry_write
memory_items_table -. retrieve .-> hybrid_search
memory_items_table -. embed source .-> embedding_path
projects -. file search .-> hybrid_search
hybrid_search -. report .-> maintenance
memory_items_table -. inspect .-> maintenance
