{
  "version": 1,
  "sourceMemoryRoot": "${OPENCLAW_WORKSPACE:-~/.openclaw/workspace}",
  "sourceFiles": [
    "MEMORY.md",
    "memory/browser.md",
    "memory/preferences.md",
    "memory/projects.md",
    "memory/learned-fixes.md",
    "memory/gateway.md",
    "memory/worker.md"
  ],
  "sourceGlobs": [
    "memory/daily/*.md",
    "memory/projects/**/*.md"
  ],
  "chunkTargetWords": 100,
  "chunkOverlapWords": 25,
  "indexDb": "./memory.sqlite",
  "chunksDir": "./chunks",
  "embeddingsDir": "./embeddings",
  "logsDir": "./logs"
}
