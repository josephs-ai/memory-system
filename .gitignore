__pycache__/
*.pyc
*.pyo
*.pyd
*.log
*.db
*.sqlite
*.sqlite3
*.tar.gz
*.zip
*.bak
*.swp
*.egg-info/
dist/
build/

# Runtime state
embeddings/
chunks/
dehydrated/
runtime/
logs/
timeline/

# Development reports (keep locally, not in repo)
REPORT_*.md
GAMEDEV_SPEC.md

# Legacy / migration artifacts
legacy/

# Orchestrator (separate repo)
orchestrator/

# Virtual envs
venv/
.venv/

# Environment files
*.env
.env
.env.*

# IDE
.idea/
.vscode/
*.code-workspace

# Infrastructure data (use docker volumes)
control_panel/neo4j_data/
control_panel/qdrant_data/
control_panel/__pycache__/
scripts/__pycache__/

# Health artifacts (generated)
health/*.json

# Backup files
README.md.bak

# Backup directories
control_panel_final_backup/
control_panel_working_backup/
control-panel/

# Bak files
*.bak

# Runtime config (contains local paths)
# config.json is tracked but should be templated
control_panel/control_panel_config.json

# Large benchmark datasets (>100MB, download separately)
benchmarks/longmemeval/longmemeval_s.json
benchmarks/longmemeval/longmemeval_s_cleaned.json

# Benchmark datasets (downloaded at runtime)
benchmarks/datasets/locomo/*.json
benchmarks/datasets/hotpotqa/*.json

# Benchmark results (machine-specific)
benchmarks/results/

# Old control panel backup
control_panel/templates/*_backup*

# Python
__pycache__/
*.pyc

# Local absolute paths; copy config.example.json and edit
config.json

# Working data that must never reach the repo.
# A `git add -A` here would otherwise stage ~5,700 files including a 356 MB
# embeddings dump.
.trash/
backups/
backfill/
*.tsv.gz
*.err
*.out

# Live process state: pids and ports change every restart, so tracking them
# produces a diff on every boot and merge conflicts between machines.
runtime/*.pid
runtime/*.json

# Per-agent cursor position: which byte of which transcript was last processed.
# Machine-local and rewritten constantly (a single backfill rewound 28 of them),
# so tracking new ones just adds churn. Files already tracked stay tracked.
state/*.json
state/*.lock
state/cursors/
